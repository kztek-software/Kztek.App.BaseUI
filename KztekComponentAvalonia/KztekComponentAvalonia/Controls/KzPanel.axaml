<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KztekComponentAvalonia.Controls.KzPanel"
             x:Name="Root">

  <Border Name="PanelRoot"
          Background="{StaticResource kz.brush.white}"
          BorderBrush="{StaticResource kz.brush.border}"
          BorderThickness="1"
          CornerRadius="{StaticResource kz.radius.lg}"
          Padding="20"
          BoxShadow="{StaticResource kz.shadow.sm}">
    <Border.Transitions>
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Border.Transitions>
    <ContentPresenter Content="{Binding PanelContent, ElementName=Root}" />
  </Border>
</UserControl>
