<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KztekComponentAvalonia.Controls.KzPasswordTextBox">

  <Border Name="PART_Border"
          Background="{StaticResource kz.brush.white}"
          BorderBrush="{StaticResource kz.brush.border}"
          BorderThickness="1"
          CornerRadius="{StaticResource kz.radius.md}"
          MinHeight="{StaticResource kz.height.md}">
    <Border.Transitions>
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Border.Transitions>

    <Grid ColumnDefinitions="*,40">

      <!-- Password input -->
      <TextBox Name="PART_Input"
               Grid.Column="0"
               PasswordChar="●"
               Watermark="Nhập mật khẩu"
               Background="Transparent"
               BorderThickness="0"
               Padding="12,0,0,0"
               VerticalContentAlignment="Center"
               CaretBrush="{StaticResource kz.brush.navy.900}"
               SelectionBrush="{StaticResource kz.brush.orange.300}"
               FontSize="{StaticResource kz.font.md}" />

      <!-- Eye toggle button -->
      <Button Name="PART_EyeBtn"
              Grid.Column="1"
              Background="Transparent"
              BorderThickness="0"
              Padding="0"
              Width="40"
              Cursor="Hand"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center">

        <Panel>
          <!-- Eye OPEN icon (svg path) — shown when password is hidden -->
          <Path Name="PART_EyeOpen"
                Stretch="Uniform"
                Width="18" Height="14"
                Fill="{StaticResource kz.brush.text.muted}"
                Data="M 1 8 C 3.5 3 6.5 1.5 12 1.5 C 17.5 1.5 20.5 3 23 8 C 20.5 13 17.5 14.5 12 14.5 C 6.5 14.5 3.5 13 1 8 Z M 12 5 C 9.791 5 8 6.791 8 9 C 8 11.209 9.791 13 12 13 C 14.209 13 16 11.209 16 9 C 16 6.791 14.209 5 12 5 Z M 10.5 9 C 10.5 8.172 11.172 7.5 12 7.5 C 12.828 7.5 13.5 8.172 13.5 9 C 13.5 9.828 12.828 10.5 12 10.5 C 11.172 10.5 10.5 9.828 10.5 9 Z" />

          <!-- Eye SLASH icon — shown when password is visible -->
          <Canvas Name="PART_EyeSlash"
                  Width="18" Height="14"
                  IsVisible="False">
            <Path Stroke="{StaticResource kz.brush.text.muted}"
                  StrokeThickness="1.5"
                  StrokeLineCap="Round"
                  Data="M 1 8 C 3.5 3 6.5 1.5 12 1.5 C 17.5 1.5 20.5 3 23 8 C 20.5 13 17.5 14.5 12 14.5 C 6.5 14.5 3.5 13 1 8 Z" />
            <Path Stroke="{StaticResource kz.brush.text.muted}"
                  StrokeThickness="1.5"
                  StrokeLineCap="Round"
                  Data="M 2 2 L 22 14" />
          </Canvas>
        </Panel>
      </Button>
    </Grid>
  </Border>
</UserControl>
