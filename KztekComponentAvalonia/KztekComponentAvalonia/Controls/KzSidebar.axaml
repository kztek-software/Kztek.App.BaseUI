<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls"
             x:Class="KztekComponentAvalonia.Controls.KzSidebar"
             x:Name="Root">

  <Border Background="{StaticResource kz.brush.navy.900}"
          Width="240">
    <DockPanel>

      <!-- Header / Logo area -->
      <Border DockPanel.Dock="Top"
              Padding="16,20,16,16"
              BorderBrush="{StaticResource kz.brush.navy.700}"
              BorderThickness="0,0,0,1">
        <ContentPresenter Name="HeaderPresenter"
                          Content="{Binding Header, ElementName=Root}" />
      </Border>

      <!-- Navigation list -->
      <ListBox Name="NavList"
               Padding="8,8,8,8"
               Background="Transparent"
               BorderThickness="0"
               SelectionMode="Single">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="2" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
          </Style>
        </ListBox.Styles>
      </ListBox>

    </DockPanel>
  </Border>
</UserControl>
