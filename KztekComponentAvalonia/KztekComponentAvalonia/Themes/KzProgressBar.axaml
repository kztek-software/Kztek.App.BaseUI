<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls">

  <ControlTheme x:Key="{x:Type kz:KzProgressBar}" TargetType="kz:KzProgressBar">
    <Setter Property="Background" Value="{StaticResource kz.brush.navy.100}" />
    <Setter Property="Foreground" Value="{StaticResource kz.brush.navy.900}" />
    <Setter Property="MinHeight" Value="8" />
    <Setter Property="Maximum"   Value="100" />
    <Setter Property="Minimum"   Value="0" />

    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Track"
                Background="{TemplateBinding Background}"
                CornerRadius="9999"
                ClipToBounds="True"
                MinHeight="{TemplateBinding MinHeight}">
          <Border Name="PART_Indicator"
                  Background="{TemplateBinding Foreground}"
                  CornerRadius="9999"
                  HorizontalAlignment="Left">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>

    <!-- ── Accent (Orange) ── -->
    <Style Selector="^.kz-progress-accent">
      <Setter Property="Foreground" Value="{StaticResource kz.brush.orange.500}" />
      <Setter Property="Background" Value="{StaticResource kz.brush.accent.bg}" />
    </Style>

    <!-- ── Success (Green) ── -->
    <Style Selector="^.kz-progress-success">
      <Setter Property="Foreground" Value="{StaticResource kz.brush.success}" />
      <Setter Property="Background" Value="{StaticResource kz.brush.success.bg}" />
    </Style>

    <!-- ── Indeterminate ── -->
    <Style Selector="^:indeterminate /template/ Border#PART_Indicator">
      <Setter Property="Width" Value="60" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
