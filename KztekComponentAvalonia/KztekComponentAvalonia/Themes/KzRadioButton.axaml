<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls">

  <ControlTheme x:Key="{x:Type kz:KzRadioButton}" TargetType="kz:KzRadioButton">
    <Setter Property="Cursor"   Value="Hand" />
    <Setter Property="FontSize" Value="{StaticResource kz.font.md}" />
    <Setter Property="Foreground" Value="{StaticResource kz.brush.text}" />
    <Setter Property="Padding" Value="0" />

    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

          <!-- Circular indicator -->
          <Border Name="Indicator"
                  Width="18" Height="18"
                  VerticalAlignment="Center"
                  CornerRadius="9999"
                  Background="{StaticResource kz.brush.white}"
                  BorderBrush="{StaticResource kz.brush.border}"
                  BorderThickness="2">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background"   Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush"  Duration="0:0:0.12" />
              </Transitions>
            </Border.Transitions>

            <!-- Inner dot (shown when checked) -->
            <Ellipse Name="Dot"
                     Width="8" Height="8"
                     Fill="White"
                     IsVisible="False"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
          </Border>

          <!-- Label -->
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <!-- ── Checked ── -->
    <Style Selector="^:checked /template/ Border#Indicator">
      <Setter Property="Background"  Value="{StaticResource kz.brush.navy.900}" />
      <Setter Property="BorderBrush" Value="{StaticResource kz.brush.navy.900}" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#Dot">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- ── Hover (unchecked) ── -->
    <Style Selector="^:pointerover /template/ Border#Indicator">
      <Setter Property="BorderBrush" Value="{StaticResource kz.brush.navy.700}" />
    </Style>

    <!-- ── Hover (checked) ── -->
    <Style Selector="^:checked:pointerover /template/ Border#Indicator">
      <Setter Property="Background"  Value="{StaticResource kz.brush.navy.hover}" />
      <Setter Property="BorderBrush" Value="{StaticResource kz.brush.navy.hover}" />
    </Style>

    <!-- ── Focus ── -->
    <Style Selector="^:focus /template/ Border#Indicator">
      <Setter Property="BoxShadow" Value="{StaticResource kz.shadow.focus}" />
    </Style>

    <!-- ── Disabled ── -->
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
