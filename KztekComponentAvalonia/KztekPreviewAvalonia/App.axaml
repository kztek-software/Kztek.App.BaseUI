<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KztekPreviewAvalonia.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />

    <!-- Load tokens first so StyleInclude files can reference them -->
    <Styles>
      <Styles.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://KztekComponentAvalonia/Theme/KzTokens.axaml" />
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </Styles.Resources>
    </Styles>

    <!-- Selector-based styles (must be in Application.Styles) -->
    <StyleInclude Source="avares://KztekComponentAvalonia/Themes/KzDataGrid.axaml" />
    <StyleInclude Source="avares://KztekComponentAvalonia/Themes/KzTabControl.axaml" />
    <StyleInclude Source="avares://KztekComponentAvalonia/Themes/KzDateTimePicker.axaml" />
    <StyleInclude Source="avares://KztekComponentAvalonia/Themes/KzMenu.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Tokens + ControlThemes -->
        <ResourceInclude Source="avares://KztekComponentAvalonia/Themes/Default.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
