<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kz="clr-namespace:KztekComponentAvalonia.Controls;assembly=KztekComponentAvalonia"
             x:Class="KztekPreviewAvalonia.Pages.SidebarPage">

  <StackPanel Spacing="24">

    <!-- DataGrid styling demo (manual table to show design) -->
    <StackPanel Spacing="4">
      <TextBlock Text="KzDataGrid — Bảng dữ liệu sản phẩm"
                 FontSize="18" FontWeight="SemiBold"
                 Foreground="{StaticResource kz.brush.navy.900}" />
      <TextBlock Text="Header Navy900, alternating rows Navy100, hover highlight."
                 FontSize="13" Foreground="{StaticResource kz.brush.text.muted}" />
    </StackPanel>

    <!-- Manual styled table showing the design -->
    <Border BorderBrush="{StaticResource kz.brush.border}"
            BorderThickness="1"
            CornerRadius="{StaticResource kz.radius.md}"
            ClipToBounds="True">
      <StackPanel>
        <!-- Header row -->
        <Grid ColumnDefinitions="100,280,130,90,110"
              Background="{StaticResource kz.brush.navy.900}">
          <TextBlock Grid.Column="0" Text="Mã SP"
                     Foreground="{StaticResource kz.brush.white}" FontWeight="SemiBold"
                     FontSize="{StaticResource kz.font.sm}" Padding="12,10" />
          <TextBlock Grid.Column="1" Text="Tên sản phẩm"
                     Foreground="{StaticResource kz.brush.white}" FontWeight="SemiBold"
                     FontSize="{StaticResource kz.font.sm}" Padding="12,10" />
          <TextBlock Grid.Column="2" Text="Giá (VNĐ)"
                     Foreground="{StaticResource kz.brush.white}" FontWeight="SemiBold"
                     FontSize="{StaticResource kz.font.sm}" Padding="12,10" />
          <TextBlock Grid.Column="3" Text="Tồn kho"
                     Foreground="{StaticResource kz.brush.white}" FontWeight="SemiBold"
                     FontSize="{StaticResource kz.font.sm}" Padding="12,10" />
          <TextBlock Grid.Column="4" Text="Trạng thái"
                     Foreground="{StaticResource kz.brush.white}" FontWeight="SemiBold"
                     FontSize="{StaticResource kz.font.sm}" Padding="12,10" />
        </Grid>
        <!-- Row 1 (odd - white) -->
        <Grid ColumnDefinitions="100,280,130,90,110"
              Background="{StaticResource kz.brush.white}">
          <TextBlock Grid.Column="0" Text="KZ-4K01" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <TextBlock Grid.Column="1" Text="Camera IP Ngoài Trời 4K" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <TextBlock Grid.Column="2" Text="2.500.000" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <TextBlock Grid.Column="3" Text="150" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <kz:KzBadge Grid.Column="4" Content="Còn hàng" Variant="Success" BadgeType="StatusPill"
                      Margin="12,8" />
        </Grid>
        <Border Height="1" Background="{StaticResource kz.brush.border}" />
        <!-- Row 2 (even - navy.100) -->
        <Grid ColumnDefinitions="100,280,130,90,110"
              Background="{StaticResource kz.brush.navy.100}">
          <TextBlock Grid.Column="0" Text="KZ-DVR16" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <TextBlock Grid.Column="1" Text="Bộ Ghi Hình DVR 16 Kênh" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <TextBlock Grid.Column="2" Text="4.200.000" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <TextBlock Grid.Column="3" Text="48" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <kz:KzBadge Grid.Column="4" Content="Còn hàng" Variant="Success" BadgeType="StatusPill"
                      Margin="12,8" />
        </Grid>
        <Border Height="1" Background="{StaticResource kz.brush.border}" />
        <!-- Row 3 (odd) -->
        <Grid ColumnDefinitions="100,280,130,90,110"
              Background="{StaticResource kz.brush.white}">
          <TextBlock Grid.Column="0" Text="KZ-NVR08" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <TextBlock Grid.Column="1" Text="Bộ Ghi Hình NVR 8 Kênh" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <TextBlock Grid.Column="2" Text="3.800.000" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <TextBlock Grid.Column="3" Text="0" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <kz:KzBadge Grid.Column="4" Content="Hết hàng" Variant="Error" BadgeType="StatusPill"
                      Margin="12,8" />
        </Grid>
        <Border Height="1" Background="{StaticResource kz.brush.border}" />
        <!-- Row 4 (even) -->
        <Grid ColumnDefinitions="100,280,130,90,110"
              Background="{StaticResource kz.brush.navy.100}">
          <TextBlock Grid.Column="0" Text="KZ-PTZ04" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <TextBlock Grid.Column="1" Text="Camera PTZ Zoom 36x" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <TextBlock Grid.Column="2" Text="8.500.000" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <TextBlock Grid.Column="3" Text="5" FontSize="12" Padding="12,10"
                     Foreground="{StaticResource kz.brush.text}" />
          <kz:KzBadge Grid.Column="4" Content="Sắp hết" Variant="Warning" BadgeType="StatusPill"
                      Margin="12,8" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Sidebar demo -->
    <StackPanel Spacing="4">
      <TextBlock Text="KzSidebar — Điều hướng"
                 FontSize="18" FontWeight="SemiBold"
                 Foreground="{StaticResource kz.brush.navy.900}" />
      <TextBlock Text="Navy900 background, orange active indicator, hover gradient."
                 FontSize="13" Foreground="{StaticResource kz.brush.text.muted}" />
    </StackPanel>

    <Border CornerRadius="{StaticResource kz.radius.lg}"
            ClipToBounds="True"
            Height="200"
            BorderBrush="{StaticResource kz.brush.border}"
            BorderThickness="1">
      <Grid ColumnDefinitions="220,*">
        <kz:KzSidebar Grid.Column="0" Name="DemoSidebar">
          <kz:KzSidebar.Header>
            <StackPanel Spacing="2">
              <TextBlock Text="KZTEK"
                         Foreground="{StaticResource kz.brush.orange.500}"
                         FontSize="18" FontWeight="Bold" />
              <TextBlock Text="Component Library"
                         Foreground="{StaticResource kz.brush.navy.300}"
                         FontSize="10" />
            </StackPanel>
          </kz:KzSidebar.Header>
        </kz:KzSidebar>
        <Border Grid.Column="1" Padding="20"
                Background="{StaticResource kz.brush.navy.100}">
          <TextBlock Name="SidebarInfoText"
                     Text="Chọn mục để xem nội dung"
                     FontSize="14"
                     Foreground="{StaticResource kz.brush.text.muted}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
      </Grid>
    </Border>

  </StackPanel>
</UserControl>
